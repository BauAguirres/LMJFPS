---
import { createClient } from "@supabase/supabase-js";
import ReferidoCard from "../components/ReferidoCard.astro";

const supabase = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_KEY
);

const { data: referidos } = await supabase
  .from("referidos")
  .select("*");
---


<section class="text-white"  id="referidos">
      <div class="flex items-center gap-4 py-3">
          <div class="h-8 w-1.5 bg-yellow-500"></div>
          <h1 class="text-4xl font-black uppercase tracking-wide">Referidos</h1>
      </div>
    <div class="mt-4">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {referidos?.map((referido: any) => (
            <ReferidoCard 
            nombre={referido.nombre} 
            categoria={referido.categoria} 
            codigo={referido.codigo}
            link={referido.link}
            />
        ))}
        </div>
    </div>
</section>





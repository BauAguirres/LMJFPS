---
const { nombre, categoria, codigo, link } = Astro.props;
---
<div class="flex flex-col border border-red-500/30 bg-zinc-900 p-4 [clip-path:polygon(14px_0,100%_0,100%_calc(100%-14px),calc(100%-14px)_100%,0_100%,0_14px)]">
  <div class="h-1 w-10 bg-yellow-500"></div>
  <p class="mt-3 text-lg font-bold text-white">{nombre}</p>
  <p class="text-xs text-zinc-400">{categoria}</p>
  
  <div class="mt-4 flex gap-3">
    <div class="flex-1 rounded bg-zinc-800 px-3 py-2 text-center">
      <p class="font-mono text-sm font-bold text-yellow-500">{codigo}</p>
    </div>
    <a 
      href={link || "#"} 
      target="_blank"
      class="flex-1 rounded bg-gradient-to-br from-[#FF1E3C] to-[#B00020] px-3 py-2 text-center font-bold text-white transition hover:brightness-110"
    >
      USAR
    </a>
  </div>
</div>
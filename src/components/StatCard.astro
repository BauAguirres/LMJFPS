---
// Acá declaro las "props": lo que cambia de una card a otra
const { valor, etiqueta } = Astro.props;
---
<div class="border border-red-500/30 bg-zinc-900 p-6 [clip-path:polygon(16px_0,100%_0,100%_calc(100%-16px),calc(100%-16px)_100%,0_100%,0_16px)]">
  <div class="h-1 w-10 bg-yellow-500"></div>
  <p class="mt-4 font-mono text-4xl font-black">{valor}</p>
  <p class="mt-1 text-sm text-zinc-400 uppercase tracking-wide">{etiqueta}</p>
</div>
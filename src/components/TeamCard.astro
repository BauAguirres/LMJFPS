---
const { nombre, año, rol, logo_url } = Astro.props;
---
<div class="flex flex-col items-center border border-red-500/30 bg-zinc-900 p-6 [clip-path:polygon(16px_0,100%_0,100%_calc(100%-16px),calc(100%-16px)_100%,0_100%,0_16px)]">
  {logo_url ? (
    <img src={logo_url} alt={nombre} class="h-12 w-12 rounded-full object-cover border border-red-500/30" />
  ) : (
    <div class="h-12 w-12 rounded-full bg-gradient-to-br from-[#FF1E3C] to-[#B00020]"></div>
  )}
  <p class="mt-4 text-lg font-bold text-white">{nombre}</p>
  <p class="mt-1 text-sm text-zinc-400">{año} · {rol}</p>
</div>
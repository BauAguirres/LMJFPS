---
const { nombre, logo_url, link } = Astro.props;
---
<a href={link || "#"} target="_blank" class="block">
  <div class="flex flex-col items-center gap-3 border border-red-500/20 bg-zinc-900 p-4 [clip-path:polygon(14px_0,100%_0,100%_calc(100%-14px),calc(100%-14px)_100%,0_100%,0_14px)]">
    {logo_url ? (
      <img src={logo_url} alt={nombre} class="h-12 w-12 rounded object-cover" />
    ) : (
      <div class="h-12 w-12 rounded bg-red-600/30"></div>
    )}
    <p class="text-center text-sm font-bold text-white">{nombre}</p>
  </div>
</a>